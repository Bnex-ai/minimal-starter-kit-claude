# ==============================================================
# .env.example — Variáveis de ambiente do projeto
# ==============================================================
# ATENÇÃO: Este arquivo é o MODELO público. Commit este arquivo.
# Copie para .env e preencha com seus valores reais:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env com valores reais.
# ==============================================================

# --- Aplicação ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Banco de Dados ---
DATABASE_URL=

# --- Autenticação ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- APIs Externas ---
# Adicione aqui as chaves das APIs que o projeto utiliza
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENDGRID_API_KEY=

# --- Sync Externo (Session Handoff) ---
# Configure para habilitar sincronização com ferramenta externa
# Providers suportados: notion, trello, google_drive, airtable, linear, github_projects
SYNC_PROVIDER=          # ex: notion
SYNC_API_KEY=           # chave de API do provider
SYNC_DESTINATION_ID=    # ID da página/board/documento de destino
